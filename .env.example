DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require
# Legacy Hub archive/rollback settings; the active WhatsApp inbox uses n8n directly.
HUB_BASE_URL=
HUB_INTEGRATION_MASTER_KEY=
CRON_SECRET=
# Server-to-server secret shared by Miesbe and the single multi-tenant n8n workflow.
MIESBE_N8N_API_KEY=
# Configure these in Miesbe for Evolution -> n8n and Miesbe -> n8n manual sends.
N8N_EVOLUTION_WEBHOOK_URL=
N8N_WHATSAPP_SEND_WEBHOOK_URL=
N8N_WHATSAPP_SEND_SECRET=
# Optional public origin used to show the internal Miesbe agent API in settings.
MIESBE_PUBLIC_URL=
